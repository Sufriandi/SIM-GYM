@php
    use Illuminate\Support\Str;

    // =========================================================
    // FALLBACK DATA (aman kalau controller belum kirim)
    // =========================================================
    $totalMembers        = (int)($totalMembers ?? 0);
    $activeMemberships   = (int)($activeMemberships ?? 0);
    $todayCheckins       = (int)($todayCheckins ?? 0);
    $totalProducts       = (int)($totalProducts ?? 0);
    $izinPending         = (int)($izinPending ?? 0);
    $recentIzin          = $recentIzin ?? collect();

    $activeRate          = (int)($activeRate ?? ($totalMembers > 0 ? round(($activeMemberships / max($totalMembers, 1)) * 100) : 0));

    $pendapatanProdukBulanIni = (int)($pendapatanProdukBulanIni ?? 0);
    $produkTerlaris           = $produkTerlaris ?? null;

    $payload = $dashboardStatsPayload ?? [];
    $seriesCheckins = data_get($payload, 'series.checkinsLast7Days', []);
    if (!is_array($seriesCheckins)) $seriesCheckins = [];

    // =========================================================
    // DERIVED: checkin insights (7 hari)
    // =========================================================
    $values7 = [];
    $labels7 = [];
    foreach ($seriesCheckins as $row) {
        $labels7[] = (string)($row['label'] ?? '');
        $values7[] = (int)($row['value'] ?? 0);
    }

    $sum7 = array_sum($values7);
    $avg7 = count($values7) ? (int) round($sum7 / count($values7)) : 0;

    $maxCheckin = 0;
    $maxIndex = 0;
    foreach ($values7 as $i => $v) {
        if ($v > $maxCheckin) { $maxCheckin = $v; $maxIndex = $i; }
    }
    $maxCheckin = max($maxCheckin, 1);

    $bestLabel = $labels7[$maxIndex] ?? '-';

    $lastVal = (int)($values7[count($values7)-1] ?? 0);
    $prevVal = (int)($values7[count($values7)-2] ?? 0);
    $delta   = $lastVal - $prevVal;

    $trendText = $delta === 0 ? 'Stabil' : ($delta > 0 ? 'Naik' : 'Turun');
    $trendPct  = ($prevVal > 0) ? (int) round(abs($delta) / $prevVal * 100) : ($delta !== 0 ? 100 : 0);

    // =========================================================
    // Sparkline points (SVG)
    // - width 260, height 64 (viewBox)
    // - padding 8
    // =========================================================
    $sparkW = 260; $sparkH = 64; $pad = 8;
    $plotW = $sparkW - ($pad * 2);
    $plotH = $sparkH - ($pad * 2);

    $sparkPoints = [];
    $n = max(count($values7), 1);

    for ($i=0; $i<$n; $i++) {
        $x = $pad + ($plotW * ($n === 1 ? 0 : ($i / ($n - 1))));
        $v = (int)($values7[$i] ?? 0);
        $y = $pad + ($plotH - ($plotH * ($v / $maxCheckin))); // top smaller
        $sparkPoints[] = [$x, $y];
    }

    $sparkPath = '';
    foreach ($sparkPoints as $i => $pt) {
        $sparkPath .= ($i === 0 ? 'M' : 'L') . $pt[0] . ' ' . $pt[1] . ' ';
    }

    $sparkLast = $sparkPoints[count($sparkPoints)-1] ?? [$pad, $pad + $plotH];

    // =========================================================
    // Safe helper formatting
    // =========================================================
    $rupiah = function(int $n) {
        return number_format($n, 0, ',', '.');
    };
@endphp

