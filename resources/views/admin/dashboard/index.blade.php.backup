                        <span class="mt-1 w-1.5 h-1.5 rounded-full bg-gold-500"></span>
                        <span>Rutin unduh laporan keuangan & kehadiran setiap akhir bulan.</span>
                    </li>
                    <li class="flex items-start gap-2">
                        <span class="mt-1 w-1.5 h-1.5 rounded-full bg-sky-500"></span>
                        <span>Pastikan data member & membership selalu diperbarui.</span>
                    </li>
                </ul>

                <div class="mt-4 rounded-2xl bg-brand-shell/70 border border-brand-borderSoft/60 p-4">
                    <p class="text-[11px] font-semibold uppercase tracking-wide text-text-muted">Ringkas</p>
                    <p class="mt-1 text-xs text-text-muted">
                        Prioritas hari ini: proses izin pending, validasi absensi, dan cek stok produk.
                    </p>
                </div>
            </x-ui.card>

        </div>

    </div>

    {{-- =========================================================
         JS: reveal + counter + bars + progress + sparkline + tooltip
       ========================================================= --}}
    <script>
        (function () {
            const prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            function formatID(n) {
                try { return new Intl.NumberFormat('id-ID').format(n); }
                catch (e) { return String(n); }
            }

            function animateCount(el, to, duration = 900) {
                if (prefersReduced) { el.textContent = formatID(to); return; }

                const from = 0;
                const start = performance.now();

                function tick(now) {
                    const p = Math.min((now - start) / duration, 1);
                    const eased = 1 - Math.pow(1 - p, 3);
                    const val = Math.round(from + (to - from) * eased);
                    el.textContent = formatID(val);
                    if (p < 1) requestAnimationFrame(tick);
                }
                requestAnimationFrame(tick);
            }

            function runCounters(root) {
                (root || document).querySelectorAll('.js-count').forEach(el => {
                    if (el.dataset.done === '1') return;
                    const to = parseInt(el.getAttribute('data-count') || '0', 10);
                    el.textContent = prefersReduced ? formatID(to) : '0';
                    animateCount(el, isNaN(to) ? 0 : to, 900);
                    el.dataset.done = '1';
                });
            }

            function runBars(root) {
                const bars = (root || document).querySelectorAll('[data-bar-height]');
                if (!bars.length) return;

                setTimeout(() => {
                    bars.forEach(b => {
                        if (b.dataset.done === '1') return;
                        const h = parseInt(b.getAttribute('data-bar-height') || '0', 10);
                        b.style.height = (isNaN(h) ? 0 : h) + '%';
                        b.dataset.done = '1';
                    });
                }, prefersReduced ? 0 : 120);
            }

            function runProgress(root) {
                const ps = (root || document).querySelectorAll('.js-progress');
                if (!ps.length) return;

                setTimeout(() => {
                    ps.forEach(p => {
                        if (p.dataset.done === '1') return;
                        const w = parseInt(p.getAttribute('data-progress') || '0', 10);
                        p.style.width = (isNaN(w) ? 0 : w) + '%';
                        p.dataset.done = '1';
                    });
                }, prefersReduced ? 0 : 120);
            }

            function runSparkline(root) {
                const path = (root || document).querySelector('.js-sparkline-path');
                const dot  = (root || document).querySelector('.js-sparkline-dot');
                if (!path) return;

                if (path.dataset.done === '1') return;

                // Trigger draw
                setTimeout(() => {
                    path.style.strokeDashoffset = '0';
                    if (dot) {
                        dot.style.opacity = '1';
                        dot.style.transform = 'scale(1)';
                    }
                    path.dataset.done = '1';
                }, prefersReduced ? 0 : 140);
            }

            function initTooltip(root) {
                const card = root || document;
                const tip = card.querySelector('.chart-tip');
                const labelEl = card.querySelector('[data-tip-label]');
                const valueEl = card.querySelector('[data-tip-value]');
                const barsWrap = card.querySelector('[data-chart="bars"]');

                if (!tip || !labelEl || !valueEl || !barsWrap) return;
                if (barsWrap.dataset.tipReady === '1') return;

                function showTip(e, el) {
                    const rCard = card.getBoundingClientRect();
                    const rEl = el.getBoundingClientRect();
                    const x = (rEl.left - rCard.left) + (rEl.width / 2);
                    const y = (rEl.top - rCard.top) - 6;

                    labelEl.textContent = el.getAttribute('data-bar-label') || '-';
                    valueEl.textContent = el.getAttribute('data-bar-value') || '0';

                    tip.style.left = Math.max(8, Math.min(x - 45, rCard.width - 110)) + 'px';
                    tip.style.top  = Math.max(8, y) + 'px';
                    tip.classList.add('is-show');
                }

                function hideTip() {
                    tip.classList.remove('is-show');
                }

                barsWrap.querySelectorAll('[data-bar-height]').forEach(bar => {
                    bar.addEventListener('mouseenter', (e) => showTip(e, bar));
                    bar.addEventListener('mousemove',  (e) => showTip(e, bar));
                    bar.addEventListener('mouseleave', hideTip);
                });

                barsWrap.dataset.tipReady = '1';
            }

            function revealInit() {
                const items = document.querySelectorAll('.js-reveal');
                if (!items.length) return;

                const runAll = (el) => {
                    el.classList.add('is-visible');

                    // Jalankan animasi di dalam card yang sedang tampil
                    runCounters(el);
                    runBars(el);
                    runProgress(el);

                    // sparkline + tooltip hanya ada di statistik card
                    runSparkline(el);
                    initTooltip(el);
                };

                if ('IntersectionObserver' in window) {
                    const io = new IntersectionObserver((entries) => {
                        entries.forEach(e => {
                            if (e.isIntersecting) {
                                runAll(e.target);
                                io.unobserve(e.target);
                            }
                        });
                    }, { threshold: 0.10 });

                    items.forEach(i => io.observe(i));
                } else {
                    items.forEach(i => runAll(i));
                }
            }

            document.addEventListener('DOMContentLoaded', function () {
                revealInit();
                // fallback safety jika ada elemen yang tidak pakai reveal
                runCounters(document);
                runBars(document);
                runProgress(document);
            });
        })();
    </script>

</x-layouts.admin>
