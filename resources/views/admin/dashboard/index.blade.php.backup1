    {{-- =========================
         JS: animasi berbasis viewport (lebih kerasa & rapi)
       ========================= --}}
    <script>
        (function () {
            const prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            function formatID(n) {
                try { return new Intl.NumberFormat('id-ID').format(n); }
                catch (e) { return String(n); }
            }

            function animateCount(el, to, duration = 900) {
                if (prefersReduced) { el.textContent = formatID(to); return; }

                const from = 0;
                const start = performance.now();

                function tick(now) {
                    const p = Math.min((now - start) / duration, 1);
                    const eased = 1 - Math.pow(1 - p, 3);
                    const val = Math.round(from + (to - from) * eased);
                    el.textContent = formatID(val);
                    if (p < 1) requestAnimationFrame(tick);
                }
                requestAnimationFrame(tick);
            }

            function runCounters(scope) {
                scope.querySelectorAll('.js-count').forEach(el => {
                    if (el.dataset.done === '1') return;
                    el.dataset.done = '1';

                    const to = parseInt(el.getAttribute('data-count') || '0', 10);
                    el.textContent = prefersReduced ? formatID(to) : '0';
                    animateCount(el, isNaN(to) ? 0 : to, 900);
                });
            }

            function runBars(scope) {
                const bars = scope.querySelectorAll('[data-bar]');
                bars.forEach(b => {
                    if (b.dataset.done === '1') return;
                    b.dataset.done = '1';

                    const pct = parseInt(b.getAttribute('data-bar') || '0', 10);
                    const scale = Math.max(0, Math.min(100, isNaN(pct) ? 0 : pct)) / 100;

                    // bar-fill sudah pakai transition transform
                    b.style.transform = prefersReduced ? 'none' : ('scaleY(' + scale + ')');
                    if (prefersReduced) b.style.transform = 'scaleY(' + scale + ')';
                });
            }

            function runProgress(scope) {
                scope.querySelectorAll('.js-progress').forEach(p => {
                    if (p.dataset.done === '1') return;
                    p.dataset.done = '1';

                    const w = parseInt(p.getAttribute('data-progress') || '0', 10);
                    const val = Math.max(0, Math.min(100, isNaN(w) ? 0 : w));
                    p.style.width = prefersReduced ? (val + '%') : '0%';

                    requestAnimationFrame(() => {
                        p.style.width = (val + '%');
                    });
                });
            }

            function revealAndAnimate(el) {
                el.classList.add('is-visible');
                runCounters(el);
                runBars(el);
                runProgress(el);
            }

            document.addEventListener('DOMContentLoaded', function () {
                const items = document.querySelectorAll('.js-reveal');

                if (!items.length) return;

                if ('IntersectionObserver' in window) {
                    const io = new IntersectionObserver((entries) => {
                        entries.forEach(e => {
                            if (!e.isIntersecting) return;
                            revealAndAnimate(e.target);
                            io.unobserve(e.target);
                        });
                    }, { threshold: 0.12 });

                    items.forEach(i => io.observe(i));
                } else {
                    items.forEach(i => revealAndAnimate(i));
                }
            });
        })();
    </script>

